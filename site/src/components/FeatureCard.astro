---
import { url } from '../config/site';
import type { Feature } from '../data/features';

type Props = Feature;
const { title, body, caveat, href, source, icon } = Astro.props;
// Small line icons, 24px, stroke only.
const paths: Record<Feature['icon'], string> = {
  install: 'M12 3v12m0 0-4-4m4 4 4-4M4 17v3h16v-3',
  loud: 'M12 4v10m0 4v2M4 20h16L12 4z',
  metrics: 'M4 20V10m6 10V4m6 16v-7m4 7H2',
  lock: 'M6 11h12v9H6zM8 11V8a4 4 0 0 1 8 0v3',
  rust: 'M12 3l2 3 3-1 1 3 3 2-2 3 1 3-3 1-1 3-3-1-3 1-1-3-3-1 1-3-2-3 3-2 1-3 3 1z',
  api: 'M8 6l-5 6 5 6m8-12 5 6-5 6M14 4l-4 16',
  check: 'M4 12l5 5L20 6',
  edge: 'M3 18q3-2 6 0t6 0 6 0M8 13l4-4 4 4v-4h-8z',
};
---

<a class="feature card" href={url(href)} title={`Source: ${source}`}>
  <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
    <path
      d={paths[icon]}
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
  </svg>
  <h3>{title}</h3>
  <p>{body}</p>
  {caveat && <p class="caveat">Limit: {caveat}</p>}
  <span class="more">
    Read more <span aria-hidden="true">→</span>
  </span>
</a>

<style>
  .feature {
    display: flex;
    flex-direction: column;
    color: var(--text);
    text-decoration: none;
  }
  .feature:hover {
    border-color: var(--accent);
    box-shadow: var(--glow);
  }
  svg {
    color: var(--accent);
    margin-bottom: 8px;
  }
  .caveat {
    color: var(--muted);
    font-size: var(--step--1);
  }
  .more {
    margin-top: auto;
    color: var(--accent);
    font: var(--step--1) var(--mono);
    text-decoration: underline;
  }
</style>
