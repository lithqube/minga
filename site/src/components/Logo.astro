---
// The mark: a Chilote house riding a raft on waves (the minga de tiradura). Not a whale: see DESIGN.md §12.3.
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false" class="logo">
  <path d="M8 15 16 8l8 7v7H8z" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round"></path>
  <path d="M14 22v-4h4v4" fill="none" stroke="var(--accent)" stroke-width="1.6"></path>
  <path d="M6 23h20" stroke="var(--text)" stroke-width="2" stroke-linecap="round"></path>
  <path
    d="M3 27q3.25-2.5 6.5 0t6.5 0 6.5 0 6.5 0"
    fill="none"
    stroke="var(--accent-2)"
    stroke-width="1.8"
    stroke-linecap="round"
  ></path>
</svg>
