---
// Hand-authored SVG on the always-dark surface. Each variant has a text description for screen readers and no-SVG readers.
interface Props {
  variant: 'hero' | 'process';
  caption?: string;
}
const { variant, caption } = Astro.props;

const heroSteps = [
  'compose.yaml',
  'minga api: Docker Engine API v1.41',
  'Raft log: desired state + placement',
  'scheduler (Raft leader) places tasks',
  'JetStream: Assign command',
  'node supervisor: netns, IP, secrets',
  'containerd runs the container',
];
const processSteps = [
  'minga deploy and the docker CLI or Traefik call minga api (Docker Engine API v1.41, bearer token).',
  'minga api and minga manager are Raft peers over mTLS: desired state and placement live in the Raft log (openraft + redb).',
  'The manager runs the scheduler and the node supervisor, and spawns nats-server as a child process.',
  'Workers run only the supervisor. Commands, task status and logs travel over NATS JetStream with TLS.',
  'Each supervisor drives containerd over gRPC; minga logs reads the retained log stream.',
];
---

<figure class="diagram-fig">
  {variant === 'hero' && (
    <>
      <svg class="wide" viewBox="0 0 960 190" role="img" aria-labelledby="dh-t dh-d">
        <title id="dh-t">How a deploy becomes a running container</title>
        <desc id="dh-d">{heroSteps.join(', then ')}.</desc>
        <defs>
          <marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
            <path d="M0 0 10 5 0 10z" fill="#22d3ee" />
          </marker>
        </defs>
        <g class="row">
          <rect x="10" y="20" width="200" height="56" />
          <text x="110" y="53">
            compose.yaml
          </text>
          <rect x="290" y="20" width="250" height="56" />
          <text x="415" y="45">
            minga api
          </text>
          <text class="sub" x="415" y="63">
            Docker Engine API v1.41
          </text>
          <rect x="620" y="20" width="330" height="56" class="raft" />
          <text x="785" y="45">
            Raft log
          </text>
          <text class="sub" x="785" y="63">
            desired state · placement
          </text>
          <line x1="210" y1="48" x2="286" y2="48" />
          <line x1="540" y1="48" x2="616" y2="48" />
        </g>
        <g class="row">
          <rect x="10" y="118" width="200" height="56" />
          <text x="110" y="143">
            scheduler
          </text>
          <text class="sub" x="110" y="161">
            Raft leader
          </text>
          <rect x="260" y="118" width="200" height="56" class="bus" />
          <text x="360" y="143">
            JetStream
          </text>
          <text class="sub" x="360" y="161">
            assign · status · logs
          </text>
          <rect x="510" y="118" width="220" height="56" />
          <text x="620" y="143">
            node supervisor
          </text>
          <text class="sub" x="620" y="161">
            netns · IP · secrets
          </text>
          <rect x="780" y="118" width="170" height="56" />
          <text x="865" y="151">
            containerd
          </text>
          <line x1="210" y1="146" x2="256" y2="146" />
          <line x1="460" y1="146" x2="506" y2="146" />
          <line x1="730" y1="146" x2="776" y2="146" />
          <path d="M785 76 V97 H110 V114" fill="none" />
        </g>
      </svg>
      <svg class="tall" viewBox="0 0 300 520" role="img" aria-labelledby="dhv-t dhv-d">
        <title id="dhv-t">How a deploy becomes a running container</title>
        <desc id="dhv-d">{heroSteps.join(', then ')}.</desc>
        <defs>
          <marker id="ahv" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
            <path d="M0 0 10 5 0 10z" fill="#22d3ee" />
          </marker>
        </defs>
        {heroSteps.map((s, i) => {
          const [head, sub] = s.split(': ');
          const y = 8 + i * 74;
          return (
            <g class="row-v">
              <rect x="20" y={y} width="260" height="50" class={i === 2 ? 'raft' : i === 4 ? 'bus' : ''} />
              <text x="150" y={sub ? y + 21 : y + 30}>
                {head}
              </text>
              {sub && (
                <text class="sub" x="150" y={y + 39}>
                  {sub}
                </text>
              )}
              {i < heroSteps.length - 1 && <line x1="150" y1={y + 50} x2="150" y2={y + 70} />}
            </g>
          );
        })}
      </svg>
    </>
  )}
  {variant === 'process' && (
    <div class="process-scroll" role="region" aria-label="Diagram, scrolls horizontally" tabindex="0">
      <svg class="process" viewBox="0 0 720 430" role="img" aria-labelledby="dp-t dp-d">
        <title id="dp-t">Minga processes and how they talk</title>
        <desc id="dp-d">{processSteps.join(' ')}</desc>
        <defs>
          <marker id="ap" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
            <path d="M0 0 10 5 0 10z" fill="#22d3ee" />
          </marker>
        </defs>
        <text class="group" x="20" y="24">
          clients
        </text>
        <rect x="20" y="34" width="200" height="44" />
        <text x="120" y="61">
          minga deploy
        </text>
        <rect x="260" y="34" width="200" height="44" />
        <text x="360" y="61">
          docker CLI / Traefik
        </text>
        <rect x="500" y="34" width="200" height="44" />
        <text x="600" y="61">
          minga logs
        </text>

        <rect x="20" y="140" width="300" height="64" />
        <text x="170" y="167">
          minga api
        </text>
        <text class="sub" x="170" y="187">
          Docker Engine API · own Raft voter
        </text>
        <rect x="400" y="140" width="300" height="64" />
        <text x="550" y="167">
          minga manager
        </text>
        <text class="sub" x="550" y="187">
          scheduler + supervisor
        </text>
        <line x1="320" y1="166" x2="396" y2="166" />
        <line x1="400" y1="180" x2="324" y2="180" />
        <text class="label" x="360" y="160">
          Raft mTLS
        </text>

        <rect x="400" y="262" width="300" height="56" class="bus" />
        <text x="550" y="287">
          nats-server (JetStream)
        </text>
        <text class="sub" x="550" y="305">
          child process of the manager · TLS
        </text>
        <rect x="20" y="262" width="300" height="56" />
        <text x="170" y="287">
          minga worker
        </text>
        <text class="sub" x="170" y="305">
          supervisor only
        </text>
        <rect x="20" y="368" width="680" height="44" />
        <text x="360" y="395">
          containerd on every node (gRPC)
        </text>

        <line x1="120" y1="78" x2="120" y2="136" />
        <line x1="360" y1="78" x2="250" y2="136" />
        <path d="M600 78 V110 H712 V290 H704" fill="none" />
        <line x1="550" y1="204" x2="550" y2="258" />
        <line x1="320" y1="290" x2="396" y2="290" />
        <line x1="170" y1="318" x2="170" y2="364" />
        <line x1="440" y1="204" x2="440" y2="364" class="dashed" />
        <text class="label" x="358" y="282">
          status · logs
        </text>
      </svg>
    </div>
  )}
  <figcaption class="muted">
    {caption}
    <details>
      <summary>Text description</summary>
      <ol>
        {(variant === 'hero' ? heroSteps : processSteps).map((s) => (
          <li>{s}</li>
        ))}
      </ol>
    </details>
  </figcaption>
</figure>

<style>
  .diagram-fig {
    margin: 32px 0 0;
  }
  svg {
    display: block;
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 8px;
  }
  /* Drawn at 720 units: below that width it scrolls instead of shrinking its 12px labels. */
  .process-scroll {
    overflow-x: auto;
    max-width: 760px;
  }
  .process {
    min-width: 720px;
  }
  .tall {
    max-width: 340px;
    margin: 0 auto;
  }
  .wide {
    display: none;
  }
  @media (min-width: 640px) {
    .wide {
      display: block;
    }
    .tall {
      display: none;
    }
  }
  rect {
    fill: #16213a;
    stroke: #22d3ee;
    stroke-width: 1.2;
    rx: 2px;
  }
  rect.raft {
    stroke: #e879f9;
  }
  rect.bus {
    stroke: #4ade80;
  }
  line,
  path {
    stroke: #22d3ee;
    stroke-width: 1.4;
    marker-end: url(#ah);
  }
  .tall line {
    marker-end: url(#ahv);
  }
  .process line,
  .process path {
    marker-end: url(#ap);
  }
  .dashed {
    stroke-dasharray: 4 4;
    stroke: #94a3b8;
    marker-end: none !important;
  }
  text {
    fill: #e5e9f0;
    font:
      600 15px ui-monospace,
      SFMono-Regular,
      Menlo,
      Consolas,
      monospace;
    text-anchor: middle;
  }
  text.sub,
  text.label,
  text.group {
    fill: #94a3b8;
    font-weight: 400;
    font-size: 12px;
  }
  text.group {
    text-anchor: start;
  }
  figcaption {
    font-size: var(--step--1);
    margin-top: 8px;
  }
  details {
    margin-top: 4px;
  }
  summary {
    padding: 6px 0;
  }
</style>
