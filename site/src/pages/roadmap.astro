---
import DocsLayout from '../layouts/DocsLayout.astro';
import { readmeSection, renderRepoFile, renderRepoMarkdown } from '../lib/repo';

const next = await renderRepoMarkdown(readmeSection('Roadmap').replace(/^## .+\n/, ''), 'README.md');
const gates = await renderRepoFile('docs/roadmap-v0.1.0.md');
---

<DocsLayout
  title="Roadmap"
  description="What Minga does next, in order, and the seven v0.1.0 release gates with their executable exit criteria."
  crumbs={[{ name: 'Roadmap', path: '/roadmap/' }]}
  sources={['README.md', 'docs/roadmap-v0.1.0.md']}
  headings={[...next.headings, { depth: 2, slug: 'gates', text: 'v0.1.0 gates (historical)' }, ...gates.headings]}
  current="/roadmap/"
>
  <Fragment set:html={next.html} />
  <h2 id="gates">v0.1.0 gates (historical): {gates.title}</h2>
  <Fragment set:html={gates.html} />
</DocsLayout>
