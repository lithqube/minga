{
  "id": "shop.web.1",
  "node_id": 3,
  "restarts": 2,
  "running_since_unix": 1794000100,
  "service_id": "shop.web",
  "spec": {
    "command": [
      "nginx"
    ],
    "entrypoint": [
      "/docker-entrypoint.sh"
    ],
    "env": {
      "MODE": "prod"
    },
    "extra_hosts": [
      [
        "db",
        "host-gateway"
      ]
    ],
    "healthcheck": {
      "interval_secs": 10,
      "retries": 3,
      "start_period_secs": 5,
      "test": [
        "CMD",
        "true"
      ],
      "timeout_secs": 3
    },
    "image": "docker.io/library/nginx:1.27",
    "ips": {
      "shop_default": "10.100.1.4"
    },
    "kind": {
      "Agent": {
        "egress_url": "http://127.0.0.1:8088",
        "fuel_limit": 1000000,
        "memory_limit": 134217728,
        "module_ref": "/var/lib/minga/modules/summarize.wasm",
        "prompt": "Summarize",
        "sandbox_env": {
          "MODEL": "small"
        },
        "timeout_secs": 30,
        "token_budget": 50000
      }
    },
    "labels": {
      "tier": "web"
    },
    "mounts": [
      {
        "kind": "Bind",
        "read_only": true,
        "source": "/srv/data",
        "target": "/data"
      }
    ],
    "ports": [
      {
        "protocol": "tcp",
        "published": 8080,
        "target": 80
      }
    ],
    "resources": {
      "cpus": 0.5,
      "gpus": 0,
      "memory_bytes": 268435456
    },
    "restart_policy": {
      "condition": "Any",
      "delay_secs": 2,
      "max_attempts": null
    },
    "secrets": [
      {
        "secret_id": "shop_password",
        "target": "/run/secrets/password",
        "version": null
      }
    ],
    "user": "101"
  },
  "state": "Running"
}
