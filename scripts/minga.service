# Runs one Minga role (manager or worker) under systemd on a Linux host.
# Install: copy to /etc/systemd/system/minga.service, write
# /etc/minga/minga.env from scripts/minga.env.example, then
#   systemctl daemon-reload && systemctl enable --now minga
#
# Not for Talos: Talos has no systemd (see docs/talos-deployment.md).

[Unit]
Description=Minga node (role from /etc/minga/minga.env)
Documentation=https://github.com/lithqube/minga
After=network-online.target containerd.service
Wants=network-online.target
Requires=containerd.service

[Service]
# minga does not speak sd_notify; the process is ready once it logs
# "starting manager loops" / "starting worker loop".
Type=simple
EnvironmentFile=/etc/minga/minga.env
# MINGA_NATS_URL, MINGA_NATS_TOKEN, MINGA_NATS_TLS_* and MINGA_METRICS_BIND
# are read from the environment directly. $MINGA_EXTRA_ARGS is split on
# whitespace (peers, labels, Raft TLS flags).
ExecStart=/usr/local/bin/minga ${MINGA_ROLE} \
  --node-id ${MINGA_NODE_ID} \
  --bind ${MINGA_BIND} \
  --data-dir /var/lib/minga \
  --runtime containerd \
  --containerd-socket /run/containerd/containerd.sock \
  $MINGA_EXTRA_ARGS
# minga shuts down gracefully (marks the node Left) on SIGINT only.
KillSignal=SIGINT
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576
# Runs as root with full capabilities: the supervisor creates network
# namespaces, bridges, veth pairs and iptables rules. Sandboxing options
# (ProtectSystem, CapabilityBoundingSet, ...) have not been tested.

[Install]
WantedBy=multi-user.target
