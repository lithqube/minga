# /etc/minga/minga.env, read by scripts/minga.service.

# manager (scheduler + supervisor + NATS sidecar) or worker (supervisor).
MINGA_ROLE=manager

# Unique numeric Raft id and the Raft RPC address peers dial.
MINGA_NODE_ID=1
MINGA_BIND=10.0.0.1:7001

# Every other node, as --peer id=address. Membership is fixed at first
# start: list all nodes, and start them together.
# Also: --label key=value, --raft-tls-ca/--raft-tls-cert/--raft-tls-key.
MINGA_EXTRA_ARGS=--peer 2=10.0.0.2:7001 --peer 3=10.0.0.3:7001

# Workers must set a NATS URL. The manager's own sidecar listens on
# 127.0.0.1 only, so remote nodes need an external TLS NATS server:
#MINGA_NATS_URL=tls://nats.internal:4222
#MINGA_NATS_TOKEN=
#MINGA_NATS_TLS_CA=/etc/minga/nats-ca.pem
#MINGA_NATS_TLS_CERT=/etc/minga/nats-client.pem
#MINGA_NATS_TLS_KEY=/etc/minga/nats-client-key.pem
#MINGA_NATS_TLS_SERVER_NAME=nats.internal

# /metrics, /healthz and /readyz.
MINGA_METRICS_BIND=127.0.0.1:9100

# Log level for the JSON logs (default info).
#MINGA_LOG_LEVEL=info
